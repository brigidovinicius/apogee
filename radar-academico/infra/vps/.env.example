# Copie para .env na VPS e aplique chmod 600. Nunca versione valores reais.
APOGEE_RELEASE_SHA=local
RADAR_DB_NAME=radar_academico
RADAR_DB_USER=radar_academico
# Gere com: openssl rand -hex 32
RADAR_DB_PASSWORD=
# URL-encode a senha se ela tiver caracteres fora de A-Za-z0-9.
DATABASE_URL=postgresql://radar_academico:RADAR_DB_PASSWORD@postgres:5432/radar_academico

# Gere cada segredo com: openssl rand -hex 32
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
CRON_SECRET=
# Dedicated to the internal Apogee admin bridge. Do not reuse the catalogue token.
RADAR_ACADEMICO_ADMIN_API_TOKEN=

# Fichas válidas publicam automaticamente. O Compose define 300 segundos para
# o scheduler por padrão; este valor só vale fora desse override.
INGESTION_INTERVAL_SECONDS=86400
INGESTION_MAX_PAGES_PER_RUN=20
INGESTION_REQUEST_DELAY_MS=2000
INGESTION_MAX_FILE_SIZE_MB=15
INGESTION_CONTACT_EMAIL=contato@apogee.community
INGESTION_USER_AGENT=RadarAcademicoBot/1.0 (+contato@apogee.community)

# Optional Resend alerts: keep disabled until the free account and sender domain are verified.
RADAR_ALERTS_ENABLED=false
RADAR_RESEND_DOMAIN_VERIFIED=false
RADAR_RESEND_API_KEY=
RADAR_RESEND_FROM=contato@apogee.community
RADAR_ALERTS_DAILY_LIMIT=50
