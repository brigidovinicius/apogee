# Runtime nunca usa DATABASE_URL. Cada URL deve ter uma senha própria provisionada fora do Git.
DATABASE_READER_URL=postgresql://radar_reader:change-reader@postgres:5432/radar_academico
DATABASE_EDITOR_URL=postgresql://radar_editor:change-editor@postgres:5432/radar_academico
# Migração: configure DATABASE_MIGRATION_URL em arquivo protegido de operador,
# separado do .env carregado pelo Next. Nunca forneça credencial de DBA ao web.
DATABASE_POOL_MAX=5
DATABASE_SSL=false
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
CRON_SECRET=
NEXT_PUBLIC_COVERAGE_LABEL="Beta: UFSC, oportunidades de Santa Catarina e programas nacionais selecionados"
NEXT_PUBLIC_CONTACT_EMAIL=
INGESTION_USER_AGENT=
INGESTION_CONTACT_EMAIL=
INGESTION_MAX_PAGES_PER_RUN=20
INGESTION_REQUEST_DELAY_MS=2000
INGESTION_MAX_FILE_SIZE_MB=15
INGESTION_DEFAULT_INTERVAL_HOURS=24
RADAR_PORT=3100
