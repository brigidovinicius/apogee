{
  "name": "radar-academico",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "test:ai-foundation": "node --test --test-concurrency=1 ai-worker/test/*.test.mjs reconciliation-worker/test/*.test.mjs",
    "test:ai-postgres": "node ai-worker/test/postgres-runner.mjs",
    "test:jobs-postgres": "node scripts/test-jobs-postgres.mjs",
    "test:runtime-roles": "node scripts/test-runtime-roles.mjs",
    "test:runtime-compose": "node --test tests/runtime-compose.test.mjs tests/docker-context.test.mjs",
    "migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "typegen": "next typegen --webpack"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "next": "16.4.6",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "robots-parser": "^3.0.1",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "braces": "file:vendor/braces"
  },
  "overrides": {
    "braces": "$braces"
  }
}
