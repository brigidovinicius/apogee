# Future separate monitor host. No real credentials; not installed by this file.
GOOGLE_CALENDAR_MONITOR_ORIGIN=https://www.apogee.community
# Read-only value, different from the worker's synchronization secret.
GOOGLE_CALENDAR_MONITOR_SECRET=
GOOGLE_CALENDAR_MONITOR_INTERVAL_SECONDS=60
GOOGLE_CALENDAR_MONITOR_TIMEOUT_MS=10000
GOOGLE_CALENDAR_WORKER_MAX_AGE_SECONDS=240
GOOGLE_CALENDAR_MONITOR_DRAIN_BUDGET_SECONDS=900
# Empty disables external delivery. Choose and authorize a receiver separately.
GOOGLE_CALENDAR_MONITOR_ALERT_WEBHOOK_URL=
GOOGLE_CALENDAR_MONITOR_STATE_FILE=/var/lib/apogee-calendar-monitor/alerts.json
GOOGLE_CALENDAR_MONITOR_SNAPSHOT_FILE=/var/lib/apogee-calendar-monitor/status.json
