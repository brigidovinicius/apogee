# Copie para .env na VPS (permissão 0600). Nunca versione valores reais.
APPLICATION_ORIGIN=https://apogee.community
APPLICATION_HOSTING_PROVIDER=caddy
BETTER_AUTH_URL=https://apogee.community
BETTER_AUTH_SECRET=

# PgBouncer é resolvido pela rede Docker externa apogee_membros_edge.
DATABASE_URL=postgres://apogee_app:SUBSTITUA_PELA_SENHA@pgbouncer:5432/apogee_membros
DATABASE_CA_CERT_FILE=/run/apogee/pgbouncer-ca.crt
DATABASE_POOL_MAX=5
# Caminho no host da VPS; somente server.crt é montado no container web.
PGBOUNCER_CA_PATH=/opt/apogee-membros/certs/server.crt

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
APPLICATION_SIGNING_SECRET=
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
APPLICATION_EXPORT_TOKEN=
