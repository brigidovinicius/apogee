{
  servers {
    timeouts {
      read_header 10s
      read_body 35s
    }
  }
}

# Caddy is the only internet-facing service. It provisions and renews TLS after
# apogee.community points to this VPS and ports 80/443 reach this container.
apogee.community {
  redir https://www.apogee.community{uri} permanent
}

www.apogee.community {
  encode zstd gzip
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), geolocation=(), microphone=()"
    -Server
  }
  # remote_ip rejects TLS early data with 425 until the peer is verified.
  # Browsers retry after the handshake; HTTP/3 stays enabled (RFC 8470).
  @verified_peer remote_ip 0.0.0.0/0 ::/0
  reverse_proxy @verified_peer web:3000 {
    # Caddy é a única borda. Não confiar em IPs enviados pelo cliente ou outro CDN.
    header_up X-Apogee-Client-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up -X-Vercel-Forwarded-For
    header_up -X-Real-IP
    header_up -CF-Connecting-IP
    header_up -Forwarded
  }
}
