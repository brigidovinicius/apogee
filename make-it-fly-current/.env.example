# Server-only. Never use a NEXT_PUBLIC_ prefix for any of these variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Legacy service_role JWT fallback, only if a new secret key is unavailable.
# SUPABASE_SERVICE_ROLE_KEY=
APPLICATION_SIGNING_SECRET=
APPLICATION_ORIGIN=https://www.apogee.community
# Internal URL of the isolated Radar service. Never expose this as NEXT_PUBLIC.
RADAR_ACADEMICO_API_URL=
RADAR_ACADEMICO_API_TOKEN=
# Optional override for the trusted client-IP header: vercel, netlify or caddy.
# Use caddy only when Caddy is the public reverse proxy; it overwrites the
# forwarding headers before requests reach the private web container.
# APPLICATION_HOSTING_PROVIDER=caddy

# Área de membros. Defina somente após aprovar uma conectividade remota privada/allowlisted.
# Ver infra/membros/README.md.
DATABASE_URL=
# Conteúdo de infra/membros/certs/server.crt com \n no lugar das quebras de linha (valida o servidor).
DATABASE_CA_CERT=
# Alternativa ao valor acima: caminho do certificado montado somente em leitura.
# DATABASE_CA_CERT_FILE=/run/apogee/pgbouncer-ca.crt
# openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://www.apogee.community
# Google OAuth. Configure no provedor somente depois de aprovar o gate externo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Convites/verificação: habilitar apenas com domínio e conta Resend aprovados.
# O provedor aceitar o envio não comprova recebimento na caixa do destinatário.
MEMBERS_EMAIL_ENABLED=false
MEMBERS_RESEND_DOMAIN_VERIFIED=false
MEMBERS_RESEND_API_KEY=
MEMBERS_RESEND_FROM=contato@apogee.community
MEMBERS_INVITATION_TTL_HOURS=48

# Radar vitalício: ativar somente após aplicar a migração e validar o webhook.
# test/live exigem credenciais e Price/Product IDs do MESMO ambiente Stripe.
RADAR_BILLING_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RADAR_PRICE_ID=
STRIPE_RADAR_PRODUCT_ID=

# Optional direct Google Calendar connection (does not change Google login scopes).
RADAR_CALENDAR_PERSONAL_ENABLED=false
# Enable only after migration 0010 and an operational age/guardianship review process.
MEMBERS_SUPERVISED_REGISTRATION_ENABLED=false
RADAR_GOOGLE_CALENDAR_ENABLED=false
# Optional dedicated OAuth client; defaults to the existing GOOGLE_CLIENT_ID/SECRET.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# 32 random bytes encoded as 64 hex characters. Keep stable and private.
GOOGLE_CALENDAR_ENCRYPTION_KEY=
# At least 32 random characters; shared only between web and the sync worker.
GOOGLE_CALENDAR_SYNC_SECRET=
# Sequential work per HTTP call; worker immediately drains the next due batch.
GOOGLE_CALENDAR_SYNC_BATCH_SIZE=3
GOOGLE_CALENDAR_SYNC_BUDGET_SECONDS=90
# Maximum overdue time before the protected monitor reports unhealthy.
GOOGLE_CALENDAR_SYNC_MAX_LAG_SECONDS=900
# Persistent retries: exponential delay plus jitter; provider Retry-After is a floor.
GOOGLE_CALENDAR_RETRY_BASE_SECONDS=60
GOOGLE_CALENDAR_RETRY_MAX_SECONDS=3600
GOOGLE_CALENDAR_RETRY_MAX_ATTEMPTS=8
# Optional operational webhook. Leave empty until destination/delivery are authorized.
GOOGLE_CALENDAR_ALERT_WEBHOOK_URL=
