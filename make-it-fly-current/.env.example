# Server-only. Never use a NEXT_PUBLIC_ prefix for any of these variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Legacy service_role JWT fallback, only if a new secret key is unavailable.
# SUPABASE_SERVICE_ROLE_KEY=
APPLICATION_SIGNING_SECRET=
APPLICATION_ORIGIN=https://makeitfly.vercel.app
# Optional override for trusted client-IP headers: vercel or netlify.
# Normally detected from VERCEL=1 or NETLIFY=true. Other hosts share one rate bucket.
# APPLICATION_HOSTING_PROVIDER=
