# Server-only. Never use a NEXT_PUBLIC_ prefix for any of these variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Legacy service_role JWT fallback, only if a new secret key is unavailable.
# SUPABASE_SERVICE_ROLE_KEY=
APPLICATION_SIGNING_SECRET=
APPLICATION_ORIGIN=https://makeitfly.vercel.app
# Optional override for trusted client-IP headers: vercel or netlify.
# Normally detected from VERCEL=1 or NETLIFY=true. Other hosts share one rate bucket.
# APPLICATION_HOSTING_PROVIDER=

# Área de membros. Defina somente após aprovar uma conectividade remota privada/allowlisted.
# Ver infra/membros/README.md.
DATABASE_URL=
# Conteúdo de infra/membros/certs/server.crt com \n no lugar das quebras de linha (valida o servidor).
DATABASE_CA_CERT=
# openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://makeitfly.vercel.app
