# Server-only. Never use a NEXT_PUBLIC_ prefix for any of these variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Legacy service_role JWT fallback, only if a new secret key is unavailable.
# SUPABASE_SERVICE_ROLE_KEY=
APPLICATION_SIGNING_SECRET=
APPLICATION_ORIGIN=https://www.apogee.community
# Internal URL of the isolated Radar service. Never expose this as NEXT_PUBLIC.
RADAR_ACADEMICO_API_URL=
# Optional override for the trusted client-IP header: vercel, netlify or caddy.
# Use caddy only when Caddy is the public reverse proxy; it overwrites the
# forwarding headers before requests reach the private web container.
# APPLICATION_HOSTING_PROVIDER=caddy

# Área de membros. Defina somente após aprovar uma conectividade remota privada/allowlisted.
# Ver infra/membros/README.md.
DATABASE_URL=
# Conteúdo de infra/membros/certs/server.crt com \n no lugar das quebras de linha (valida o servidor).
DATABASE_CA_CERT=
# Alternativa ao valor acima: caminho do certificado montado somente em leitura.
# DATABASE_CA_CERT_FILE=/run/apogee/pgbouncer-ca.crt
# openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://www.apogee.community
